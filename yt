#!/bin/bash

# Скрипт для скачивания видео с YouTube с использованием yt-dlp.
VERSION="1.6.0"

# --- Цвета и функции логирования ---
RED='\033[0;31m'
GREEN='\033[0;32m'
VERY_LIGHT_BLUE='\033[0;36m'
NC='\033[0m' # No Color

log() {
    echo -e "${VERY_LIGHT_BLUE}[$(date '+%Y-%m-%d %H:%M:%S')]${NC} $1"
}

error() {
    echo -e "${RED}[ОШИБКА]${NC} $1" >&2
    exit 1
}

success() {
    echo -e "${GREEN}[УСПЕХ]${NC} $1"
}

# --- Конфигурация ---
VIDEO_DIR="$HOME/video"
AUDIO_DIR="$HOME/audio"
URL=""
AUDIO_ONLY=false
DEBUG_MODE=false
DATE_AFTER=""

# --- Определение массовой загрузки (канал/плейлист) ---
# Одиночными считаются: youtu.be/<id>, /watch?v=<id>, /shorts/<id>,
# /embed/<id>, /live/<id> — при отсутствии параметра list=.
# Всё остальное (каналы /@handle, /channel/UC..., /c/, /user/, tabs,
# /playlist?list=, поиск, watch-ссылки с list=) — массовая загрузка.
is_bulk_download() {
    local url="$1"
    if [[ "$url" =~ (\?|&)list= ]]; then
        return 0
    fi
    if [[ "$url" =~ ^https?://(www\.|m\.)?youtu\.be/[0-9A-Za-z_-]{11}($|[?&]) ]] \
        || [[ "$url" =~ /watch\?[^#]*v=[0-9A-Za-z_-]{11} ]] \
        || [[ "$url" =~ /shorts/[0-9A-Za-z_-]{11}($|[?&]) ]] \
        || [[ "$url" =~ /embed/[0-9A-Za-z_-]{11} ]] \
        || [[ "$url" =~ /live/[0-9A-Za-z_-]{11} ]]; then
        return 1
    fi
    return 0
}

# --- Разбор аргументов ---
if [[ $# -eq 0 ]]; then
    echo "Использование: $0 -u <YOUTUBE_URL> [-a] [-d] [-y N] [-m N]"
    echo "  -u, --url    URL видео на YouTube"
    echo "  -a, --audio  Скачать только аудио в формате mp3"
    echo "  -d, --debug  Включить режим отладки (показывать предупреждения yt-dlp)"
    echo "  -y, --years    N    Скачать только видео за последние N лет"
    echo "  -m, --months   N    Скачать только видео за последние N месяцев"
    exit 1
fi

while [[ $# -gt 0 ]]; do
    case $1 in
        -u|--url)
            URL="$2"
            shift 2
            ;;
        -a|--audio)
            AUDIO_ONLY=true
            shift 1
            ;;
        -d|--debug)
            DEBUG_MODE=true
            shift 1
            ;;
        -y|--years)
            if [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
                error "Параметр -y требует целое положительное число (количество лет)."
            fi
            DATE_AFTER="now-${2}year"
            shift 2
            ;;
        -m|--months)
            if [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
                error "Параметр -m требует целое положительное число (количество месяцев)."
            fi
            DATE_AFTER="now-${2}month"
            shift 2
            ;;
        *)
            error "Неизвестная опция: $1"
            ;;
    esac
done

if [[ -z "$URL" ]]; then
    error "URL не указан. Используйте -u или --url."
fi

log "Запуск yt v$VERSION"

# --- Проверки перед запуском ---
log "Проверка наличия yt-dlp..."
if ! command -v yt-dlp &> /dev/null; then
    error "Утилита 'yt-dlp' не найдена. Пожалуйста, установите ее."
fi
YT_DLP_VER=$(yt-dlp --version)
success "yt-dlp найден (версия: $YT_DLP_VER)."

log "Поиск файла с cookies (*cookies.txt) в домашней директории (рекурсивно)..."
COOKIES_FILE=$(find "$HOME" -name "*cookies.txt" -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n 1 | cut -d' ' -f2-)

if [[ -z "$COOKIES_FILE" || ! -f "$COOKIES_FILE" ]]; then
    error "Файл с cookies (*cookies.txt) не найден в домашней директории ($HOME)."
fi
success "Используем самый свежий файл cookies: $COOKIES_FILE"


# --- Основная логика ---
# Общие опции для yt-dlp.
# Спуфинг Android-клиента против 403 ошибки. Только android: 1 player API
# на видео вместо 3 (web_embedded/tv убраны) - втрое меньше запросов, квота
# rate-limit YouTube хватает дольше. Из-за SABR-эксперимента часть видео
# может не получить форматы через android и будет пропущена (--ignore-errors).
# Мобильный --user-agent не используется: он ведёт на m.youtube.com,
# который может не резолвиться.
YT_DLP_COMMON_OPTS="--ignore-errors --rm-cache-dir --extractor-args \"youtube:player_client=android\""

# Для массовых загрузок (канал/плейлист) включаем случайные задержки.
# --sleep-requests растягивает поток экстракции (2с x ~6 запросов на видео
# ~ 12с/видео) - это основная защита от rate-limit. --sleep-interval
# срабатывает только перед скачиванием медиа, после успешной экстракции.
if is_bulk_download "$URL"; then
    YT_DLP_COMMON_OPTS="$YT_DLP_COMMON_OPTS --sleep-requests 2 --sleep-interval 10 --max-sleep-interval 20"
fi

# Ограничение по дате загрузки (флаги -y / -m).
# Фильтр срабатывает только после полной экстракции записи (tab-записи
# каналов не содержат даты). Табы отсортированы новые->старые, поэтому
# --break-on-reject останавливает загрузку на первой записи старше cutoff.
if [[ -n "$DATE_AFTER" ]]; then
    YT_DLP_COMMON_OPTS="$YT_DLP_COMMON_OPTS --dateafter \"$DATE_AFTER\" --break-on-reject"
fi

if [ "$DEBUG_MODE" = false ]; then
    YT_DLP_COMMON_OPTS="$YT_DLP_COMMON_OPTS --no-warnings"
fi
YT_DLP_COOKIE_ARGS="--cookies \"$COOKIES_FILE\""

if [ "$AUDIO_ONLY" = true ]; then
    log "Создание директории для аудио, если она не существует..."
    mkdir -p "$AUDIO_DIR"
    success "Директория для аудио: $AUDIO_DIR"
    OUTPUT_TEMPLATE="$AUDIO_DIR/%(uploader)s/%(title)s.%(ext)s"

    log "Запуск скачивания аудио по URL: $URL"
    if eval yt-dlp $YT_DLP_COMMON_OPTS -f 'bestaudio/best' --extract-audio --audio-format mp3 --audio-quality 0 $YT_DLP_COOKIE_ARGS -o \"$OUTPUT_TEMPLATE\" \"$URL\"; then
        success "Скачивание аудио завершено."
    else
        error "yt-dlp не смог скачать аудио."
    fi
else
    log "Создание директории для видео, если она не существует..."
    mkdir -p "$VIDEO_DIR"
    success "Директория для видео: $VIDEO_DIR"
    OUTPUT_TEMPLATE="$VIDEO_DIR/%(uploader)s/%(title)s.%(ext)s"

    log "Запуск скачивания видео по URL: $URL"
    if eval yt-dlp $YT_DLP_COMMON_OPTS -f b --recode-video mp4 $YT_DLP_COOKIE_ARGS -o \"$OUTPUT_TEMPLATE\" \"$URL\"; then
        success "Скачивание видео завершено."
    else
        error "yt-dlp не смог скачать видео."
    fi
fi
