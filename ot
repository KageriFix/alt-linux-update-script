#!/bin/bash

# Скрипт для запуска scrcpy с оптимальными настройками.
VERSION="1.0.0"

# --- Цвета и функции логирования ---
RED='\033[0;31m'
GREEN='\033[0;32m'
VERY_LIGHT_BLUE='\033[0;36m'
NC='\033[0m' # No Color

log() {
    echo -e "${VERY_LIGHT_BLUE}[$(date '+%Y-%m-%d %H:%M:%S')]${NC} $1"
}

error() {
    echo -e "${RED}[ОШИБКА]${NC} $1" >&2
    exit 1
}

success() {
    echo -e "${GREEN}[УСПЕХ]${NC} $1"
}
# --- Конец секции логирования ---

main() {
    log "Запуск ot v$VERSION"
    
    if ! command -v scrcpy &> /dev/null; then
        error "scrcpy не найден. Пожалуйста, установите его (sudo epm install scrcpy android-tools)."
    fi

    log "Запуск scrcpy..."
    scrcpy --max-fps 60 --max-size 1920 --turn-screen-off --stay-awake --power-off-on-close
}

main "$@"