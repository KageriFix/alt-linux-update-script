#!/bin/bash

# Скрипт для скачивания видео с YouTube с использованием yt-dlp.

# --- Цвета и функции логирования ---
RED='\033[0;31m'
GREEN='\033[0;32m'
VERY_LIGHT_BLUE='\033[0;36m'
NC='\033[0m' # No Color

log() {
    echo -e "${VERY_LIGHT_BLUE}[$(date '+%Y-%m-%d %H:%M:%S')]${NC} $1"
}

error() {
    echo -e "${RED}[ОШИБКА]${NC} $1" >&2
    exit 1
}

success() {
    echo -e "${GREEN}[УСПЕХ]${NC} $1"
}

# --- Конфигурация ---
VIDEO_DIR="$HOME/video"
AUDIO_DIR="$HOME/audio"
URL=""
AUDIO_ONLY=false
DEBUG_MODE=false

# --- Разбор аргументов ---
if [[ $# -eq 0 ]]; then
    echo "Использование: $0 -u <YOUTUBE_URL> [-a] [-d]"
    echo "  -u, --url    URL видео на YouTube"
    echo "  -a, --audio  Скачать только аудио в формате mp3"
    echo "  -d, --debug  Включить режим отладки (показывать предупреждения yt-dlp)"
    exit 1
fi

while [[ $# -gt 0 ]]; do
    case $1 in
        -u|--url)
            URL="$2"
            shift 2
            ;;
        -a|--audio)
            AUDIO_ONLY=true
            shift 1
            ;;
        -d|--debug)
            DEBUG_MODE=true
            shift 1
            ;;
        *)
            error "Неизвестная опция: $1"
            ;;
    esac
done

if [[ -z "$URL" ]]; then
    error "URL не указан. Используйте -u или --url."
fi

# --- Проверки перед запуском ---
log "Проверка наличия yt-dlp..."
if ! command -v yt-dlp &> /dev/null; then
    error "Утилита 'yt-dlp' не найдена. Пожалуйста, установите ее."
fi
success "yt-dlp найден."

log "Поиск файла с cookies (*cookies.txt) в домашней директории (рекурсивно)..."
COOKIES_FILE=$(find "$HOME" -name "*cookies.txt" -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n 1 | cut -d' ' -f2-)

if [[ -z "$COOKIES_FILE" || ! -f "$COOKIES_FILE" ]]; then
    error "Файл с cookies (*cookies.txt) не найден в домашней директории ($HOME)."
fi
success "Используем самый свежий файл cookies: $COOKIES_FILE"


# --- Основная логика ---
# Общие опции для yt-dlp
YT_DLP_COMMON_OPTS="--ignore-errors --user-agent 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/108.0.0.0 Safari/537.36'"
if [ "$DEBUG_MODE" = false ]; then
    YT_DLP_COMMON_OPTS="$YT_DLP_COMMON_OPTS --no-warnings"
fi
YT_DLP_COOKIE_ARGS="--cookies \"$COOKIES_FILE\""

if [ "$AUDIO_ONLY" = true ]; then
    log "Создание директории для аудио, если она не существует..."
    mkdir -p "$AUDIO_DIR"
    success "Директория для аудио: $AUDIO_DIR"
    OUTPUT_TEMPLATE="$AUDIO_DIR/%(uploader)s/%(title)s.%(ext)s"

    log "Запуск скачивания аудио по URL: $URL"
    if eval yt-dlp $YT_DLP_COMMON_OPTS -f 'bestaudio/best' --extract-audio --audio-format mp3 --audio-quality 0 $YT_DLP_COOKIE_ARGS -o \"$OUTPUT_TEMPLATE\" \"$URL\"; then
        success "Скачивание аудио завершено."
    else
        error "yt-dlp не смог скачать аудио."
    fi
else
    log "Создание директории для видео, если она не существует..."
    mkdir -p "$VIDEO_DIR"
    success "Директория для видео: $VIDEO_DIR"
    OUTPUT_TEMPLATE="$VIDEO_DIR/%(uploader)s/%(title)s.%(ext)s"

    log "Запуск скачивания видео по URL: $URL"
    if eval yt-dlp $YT_DLP_COMMON_OPTS -f b --recode-video mp4 $YT_DLP_COOKIE_ARGS -o \"$OUTPUT_TEMPLATE\" \"$URL\"; then
        success "Скачивание видео завершено."
    else
        error "yt-dlp не смог скачать видео."
    fi
fi
